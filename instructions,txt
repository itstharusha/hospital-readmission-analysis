# ===== PHASE 2: STATISTICAL INFERENCE =====

library(tidyverse)
library(readmission)
library(psych)

# Load cleaned data
df <- read.csv("01_DATA/readmission_cleaned.csv")

cat("===== TASK 4: STATISTICAL INFERENCE =====\n\n")

# ===== TEST 1: AGE AND READMISSION =====

cat("TEST 1: Age and Readmission Status\n")
cat("H0: Mean age is the same for readmitted vs. non-readmitted\n")
cat("H1: Mean age differs by readmission status\n\n")

# Convert age to numeric (extract first number from age range)
df <- df %>%
  mutate(age_numeric = as.numeric(gsub("[^0-9]", "", age)))

age_yes <- df$age_numeric[df$readmitted == "Yes"]
age_no <- df$age_numeric[df$readmitted == "No"]

t_test_age <- t.test(age_yes, age_no)

# Calculate effect size (Cohen's d)
cohens_d_age <- (mean(age_yes) - mean(age_no)) / sqrt((var(age_yes) + var(age_no)) / 2)

cat("Mean age (readmitted):", round(mean(age_yes), 2), "\n")
cat("Mean age (not readmitted):", round(mean(age_no), 2), "\n")
cat("Difference:", round(mean(age_yes) - mean(age_no), 2), "years\n")
cat("T-statistic:", round(t_test_age$statistic, 3), "\n")
cat("P-value:", format.pval(t_test_age$p.value, digits = 4), "\n")
cat("Cohen's d:", round(cohens_d_age, 3), "\n")
cat("Effect size interpretation:", 
    if(abs(cohens_d_age) < 0.2) "negligible" 
    else if(abs(cohens_d_age) < 0.5) "small" 
    else if(abs(cohens_d_age) < 0.8) "medium" 
    else "large", "\n\n")

test1_result <- data.frame(
  Test = "Age vs Readmission",
  Test_Type = "Independent t-test",
  t_statistic = round(t_test_age$statistic, 3),
  p_value = round(t_test_age$p.value, 4),
  Significant = ifelse(t_test_age$p.value < 0.05, "Yes (p < 0.05)", "No"),
  Cohens_d = round(cohens_d_age, 3),
  Mean_Difference = round(mean(age_yes) - mean(age_no), 2),
  Clinical_Implication = "Age-stratified discharge planning"
)

# ===== TEST 2: GENDER AND READMISSION =====

cat("TEST 2: Gender and Readmission Status\n")
cat("H0: Readmission rates independent of gender\n")
cat("H1: Readmission rates differ by gender\n\n")

gender_table <- table(df$gender, df$readmitted)
chi_sq_gender <- chisq.test(gender_table)

cat("Contingency Table:\n")
print(gender_table)
cat("\nChi-square statistic:", round(chi_sq_gender$statistic, 3), "\n")
cat("P-value:", format.pval(chi_sq_gender$p.value, digits = 4), "\n\n")

# Readmission rates by gender
gender_props <- df %>%
  filter(gender != "Unknown") %>%
  group_by(gender) %>%
  summarise(
    total = n(),
    readmitted_count = sum(readmitted == "Yes"),
    readmission_rate = round(mean(readmitted == "Yes") * 100, 2),
    .groups = 'drop'
  )

print(gender_props)

test2_result <- data.frame(
  Test = "Gender vs Readmission",
  Test_Type = "Chi-square test",
  Chi_square_statistic = round(chi_sq_gender$statistic, 3),
  p_value = round(chi_sq_gender$p.value, 4),
  Significant = ifelse(chi_sq_gender$p.value < 0.05, "Yes (p < 0.05)", "No"),
  Cohens_d = NA,
  Mean_Difference = NA,
  Clinical_Implication = "Gender-specific protocols"
)

# ===== TEST 3: LENGTH OF STAY AND READMISSION =====

cat("TEST 3: Length of Stay and Readmission\n")
cat("H0: Mean LOS same for readmitted vs. non-readmitted\n")
cat("H1: Mean LOS differs by readmission status\n\n")

los_yes <- df$time_in_hospital[df$readmitted == "Yes"]
los_no <- df$time_in_hospital[df$readmitted == "No"]

t_test_los <- t.test(los_yes, los_no)
cohens_d_los <- (mean(los_yes) - mean(los_no)) / sqrt((var(los_yes) + var(los_no)) / 2)

cat("Mean LOS (readmitted):", round(mean(los_yes), 2), "days\n")
cat("Mean LOS (not readmitted):", round(mean(los_no), 2), "days\n")
cat("Difference:", round(mean(los_yes) - mean(los_no), 2), "days\n")
cat("T-statistic:", round(t_test_los$statistic, 3), "\n")
cat("P-value:", format.pval(t_test_los$p.value, digits = 4), "\n")
cat("Cohen's d:", round(cohens_d_los, 3), "\n\n")

test3_result <- data.frame(
  Test = "Length of Stay vs Readmission",
  Test_Type = "Independent t-test",
  t_statistic = round(t_test_los$statistic, 3),
  p_value = round(t_test_los$p.value, 4),
  Significant = ifelse(t_test_los$p.value < 0.05, "Yes (p < 0.05)", "No"),
  Cohens_d = round(cohens_d_los, 3),
  Mean_Difference = round(mean(los_yes) - mean(los_no), 2),
  Clinical_Implication = "Longer stay indicates complexity; needs intensive follow-up"
)

