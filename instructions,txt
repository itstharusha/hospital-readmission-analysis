# ===== PHASE 3: PREDICTIVE STATISTICAL MODELLING =====

library(tidyverse)
library(caret)
library(glmnet)
library(pROC)
library(readmission)

df <- read.csv("01_DATA/readmission_cleaned.csv")

cat("===== TASK 5: PREDICTIVE STATISTICAL MODELLING =====\n\n")

# ===== DATA PREPARATION =====

cat("STEP 1: Data Preparation for Modelling\n\n")

# Create binary target
df$readmitted_binary <- ifelse(df$readmitted == "Yes", 1, 0)

# Select features (clinical + demographic)
features_to_use <- c(
  "age", "gender", "race",
  "time_in_hospital", "num_medications", "num_lab_procedures",
  "num_procedures", "num_inpatient_visits_prior_year",
  "num_outpatient_visits_prior_year", "num_emergency_visits_prior_year",
  "diabetic_medications", "metformin", "insulin",
  "discharge_disposition_id"
)

# Prepare feature matrix
df_model <- df %>%
  select(all_of(features_to_use), readmitted_binary) %>%
  mutate(
    age = as.numeric(gsub("[^0-9]", "", age)),
    gender = as.numeric(factor(gender)),
    race = as.numeric(factor(race)),
    discharge_disposition_id = as.numeric(factor(discharge_disposition_id)),
    diabetic_medications = as.numeric(diabetic_medications == "Yes"),
    metformin = as.numeric(metformin == "Yes"),
    insulin = as.numeric(insulin == "Yes")
  ) %>%
  drop_na()

cat("Final dataset size:", nrow(df_model), "observations\n")
cat("Features:", ncol(df_model) - 1, "\n")
cat("Readmitted (1):", sum(df_model$readmitted_binary), "\n")
cat("Not readmitted (0):", nrow(df_model) - sum(df_model$readmitted_binary), "\n")
cat("Class imbalance ratio:", 
    round((nrow(df_model) - sum(df_model$readmitted_binary)) / sum(df_model$readmitted_binary), 1),
    ":1\n\n")

# ===== TRAIN/TEST SPLIT =====

cat("STEP 2: Train/Test Split (70/30 stratified)\n\n")

set.seed(42)  # Reproducibility
train_index <- createDataPartition(df_model$readmitted_binary, p = 0.7, list = FALSE)

X_train <- df_model[train_index, -ncol(df_model)] %>% as.matrix()
y_train <- df_model[train_index, "readmitted_binary"]

X_test <- df_model[-train_index, -ncol(df_model)] %>% as.matrix()
y_test <- df_model[-train_index, "readmitted_binary"]

cat("Training set: n =", nrow(X_train), "\n")
cat("Test set: n =", nrow(X_test), "\n")
cat("Class distribution (train):\n")
print(table(y_train))
cat("\n")

# ===== MODEL 1: LOGISTIC REGRESSION =====

cat("STEP 3: Model 1 - Logistic Regression\n\n")

logit_model <- glm(readmitted_binary ~ .,
                   data = df_model[train_index, ],
                   family = binomial(link = "logit"))

# Predictions
logit_pred_prob <- predict(logit_model,
                           newdata = df_model[-train_index, ],
                           type = "response")

logit_pred_class <- ifelse(logit_pred_prob > 0.5, 1, 0)

# Confusion Matrix
logit_cm <- table(Actual = y_test, Predicted = logit_pred_class)
logit_accuracy <- mean(logit_pred_class == y_test)
logit_sensitivity <- logit_cm[2, 2] / (logit_cm[2, 1] + logit_cm[2, 2])  # TPR
logit_specificity <- logit_cm[1, 1] / (logit_cm[1, 1] + logit_cm[1, 2])  # TNR

cat("Logistic Regression - Test Set Performance:\n")
print(logit_cm)
cat("\nAccuracy:", round(logit_accuracy, 4), "\n")
cat("Sensitivity (Recall - catch readmissions):", round(logit_sensitivity, 4), "\n")
cat("Specificity (correctly identify non-readmitted):", round(logit_specificity, 4), "\n")

# ROC curve
logit_roc <- roc(response = y_test, predictor = logit_pred_prob)
logit_auc <- auc(logit_roc)
cat("AUC:", round(logit_auc, 4), "\n\n")

# Plot ROC
png("03_VISUALIZATIONS/TASK5_Modeling/01_logit_roc_curve.png", width = 800, height = 600)
plot(logit_roc, main = "Logistic Regression - ROC Curve",
     xlab = "False Positive Rate", ylab = "True Positive Rate",
     lwd = 2, col = "#d62728")
legend("bottomright", paste("AUC =", round(logit_auc, 4)), cex = 1.2, bty = "n")
grid()
dev.off()
cat("✓ Saved: 01_logit_roc_curve.png\n")

